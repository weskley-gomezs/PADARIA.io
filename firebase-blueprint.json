{
  "entities": {
    "BakeryCompany": {
      "title": "BakeryCompany",
      "description": "Registered bakery enterprise in the system",
      "type": "object",
      "properties": {
        "codigoAtivacao": { "type": "string" },
        "empresa": { "type": "string" },
        "email": { "type": "string" },
        "telefone": { "type": "string" },
        "ativo": { "type": "boolean" },
        "dataCadastro": { "type": "string" },
        "ultimoAcesso": { "type": "string" },
        "financeiro": { "type": "object" },
        "contrato": { "type": "object" }
      },
      "required": ["codigoAtivacao", "empresa", "ativo"]
    },
    "Product": {
      "title": "Product",
      "description": "Bakery product with expiration date monitoring",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bakeryCode": { "type": "string" },
        "nome": { "type": "string" },
        "quantidade": { "type": "number" },
        "dataValidade": { "type": "string" },
        "categoria": { "type": "string" },
        "dataCadastro": { "type": "string" },
        "diasParaVencer": { "type": "number" },
        "status": { "type": "string", "enum": ["normal", "vencendo", "vencido"] }
      },
      "required": ["id", "bakeryCode", "nome", "quantidade", "dataValidade"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Support request or issue ticket submitted by bakery or created by admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bakeryCode": { "type": "string" },
        "empresaNome": { "type": "string" },
        "assunto": { "type": "string" },
        "descricao": { "type": "string" },
        "prioridade": { "type": "string", "enum": ["normal", "urgente", "critica"] },
        "status": { "type": "string", "enum": ["aberto", "em_andamento", "resolvido"] },
        "dataCriacao": { "type": "string" },
        "dataResolucao": { "type": "string" },
        "respostaSuporte": { "type": "string" }
      },
      "required": ["id", "bakeryCode", "assunto", "descricao", "status"]
    },
    "SaleHistoryItem": {
      "title": "SaleHistoryItem",
      "description": "History item for sold products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bakeryCode": { "type": "string" },
        "produtoId": { "type": "string" },
        "nomeProduto": { "type": "string" },
        "quantidade": { "type": "number" },
        "dataValidade": { "type": "string" },
        "dataVenda": { "type": "string" }
      },
      "required": ["id", "bakeryCode", "nomeProduto", "dataVenda"]
    },
    "AdminSettings": {
      "title": "AdminSettings",
      "description": "Global administrator configuration and custom password",
      "type": "object",
      "properties": {
        "adminPassword": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "VipOffer": {
      "title": "VipOffer",
      "description": "Product promotion offer shared in the VIP Club",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bakeryCode": { "type": "string" },
        "productId": { "type": "string" },
        "nomeProduto": { "type": "string" },
        "categoria": { "type": "string" },
        "valorOriginal": { "type": "number" },
        "valorPromocional": { "type": "number" },
        "desconto": { "type": "number" },
        "dataValidade": { "type": "string" },
        "diasParaVencer": { "type": "number" },
        "status": { "type": "string", "enum": ["ativo", "vendido", "descartado"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "dataVenda": { "type": "string" },
        "valorVenda": { "type": "number" }
      },
      "required": ["id", "bakeryCode", "productId", "nomeProduto", "valorOriginal", "valorPromocional", "status"]
    },
    "InventoryMovement": {
      "title": "InventoryMovement",
      "description": "Stock movements like entry, sale, waste, internal use or adjustment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "bakeryCode": { "type": "string" },
        "type": { "type": "string", "enum": ["ENTRY", "SALE", "WASTE", "ADJUSTMENT", "INTERNAL_USE"] },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "costAtMovement": { "type": "number" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "productId", "bakeryCode", "type", "quantity"]
    },
    "StockCount": {
      "title": "StockCount",
      "description": "Physical inventory count and stock variance record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "bakeryCode": { "type": "string" },
        "expectedQuantity": { "type": "number" },
        "physicalQuantity": { "type": "number" },
        "varianceQuantity": { "type": "number" },
        "varianceValue": { "type": "number" },
        "unit": { "type": "string" },
        "unitCost": { "type": "number" },
        "notes": { "type": "string" },
        "countedAt": { "type": "string" },
        "countedBy": { "type": "string" }
      },
      "required": ["id", "productId", "bakeryCode", "expectedQuantity", "physicalQuantity", "varianceQuantity"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Standard inventory ingredients catalog independent of expiration date module",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bakeryCode": { "type": "string" },
        "name": { "type": "string" },
        "unit": { "type": "string" },
        "currentQuantity": { "type": "number" },
        "initialQuantity": { "type": "number" },
        "unitCost": { "type": "number" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "bakeryCode", "name", "currentQuantity", "unitCost"]
    },
    "OperationalTask": {
      "title": "OperationalTask",
      "description": "Bakery team routine task and operational checklist item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bakeryCode": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "shift": { "type": "string", "enum": ["manha", "tarde", "noite", "geral"] },
        "category": { "type": "string", "enum": ["conferencia", "perdas", "producao", "fechamento", "limpeza", "geral"] },
        "status": { "type": "string", "enum": ["pendente", "concluida", "atrasada"] },
        "dueDate": { "type": "string" },
        "dueTime": { "type": "string" },
        "completedAt": { "type": "string" },
        "completedBy": { "type": "string" },
        "assignedTo": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "priority": { "type": "string", "enum": ["baixa", "media", "alta", "urgente"] }
      },
      "required": ["id", "bakeryCode", "title", "shift", "status", "dueDate"]
    }
  },
  "firestore": {
    "/companies/{companyCode}": {
      "schema": "BakeryCompany",
      "description": "Collection storing bakery companies"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection storing all bakery inventory products"
    },
    "/sales/{saleId}": {
      "schema": "SaleHistoryItem",
      "description": "Collection storing sales history"
    },
    "/tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Collection storing support tickets"
    },
    "/vipOffers/{offerId}": {
      "schema": "VipOffer",
      "description": "Collection storing VIP Club promotions and history"
    },
    "/inventoryMovements/{movementId}": {
      "schema": "InventoryMovement",
      "description": "Collection storing inventory movements"
    },
    "/stockCounts/{countId}": {
      "schema": "StockCount",
      "description": "Collection storing physical stock count audits and variances"
    },
    "/inventoryItems/{itemId}": {
      "schema": "InventoryItem",
      "description": "Collection storing standard raw inventory items and ingredients"
    },
    "/operationalTasks/{taskId}": {
      "schema": "OperationalTask",
      "description": "Collection storing daily bakery routine checklists and team tasks"
    },
    "/settings/{settingId}": {
      "schema": "AdminSettings",
      "description": "Global admin app configuration"
    }
  }
}
