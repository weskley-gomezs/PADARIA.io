rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function getUserBakeryCode() {
      let data = getUserData();
      return data != null && 'bakeryCode' in data ? data.bakeryCode : '';
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@padaria.io' || 
        (getUserData() != null && getUserData().role == 'admin')
      );
    }

    function belongsToTenant(tenantCode) {
      return isAuthenticated() && (getUserBakeryCode() == tenantCode || isAdmin());
    }

    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow update: if isAuthenticated() && (
                     (request.auth.uid == uid &&
                      request.resource.data.bakeryCode == resource.data.bakeryCode &&
                      request.resource.data.role == resource.data.role) ||
                     isAdmin()
                    );
      allow delete: if isAdmin();
    }

    match /companies/{companyCode} {
      allow read: if isAuthenticated() && belongsToTenant(companyCode);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && belongsToTenant(companyCode);
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAuthenticated() && (resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
      allow update: if isAuthenticated() && (
                     (resource.data.bakeryCode == getUserBakeryCode() && request.resource.data.bakeryCode == resource.data.bakeryCode) || 
                     isAdmin()
                    );
      allow delete: if isAuthenticated() && (resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
    }

    match /sales/{saleId} {
      allow read: if isAuthenticated() && (resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
      allow update: if isAuthenticated() && (
                     (resource.data.bakeryCode == getUserBakeryCode() && request.resource.data.bakeryCode == resource.data.bakeryCode) || 
                     isAdmin()
                    );
      allow delete: if isAuthenticated() && (resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
    }

    match /vipOffers/{offerId} {
      allow read: if isAuthenticated() && (resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
      allow update: if isAuthenticated() && (
                     (resource.data.bakeryCode == getUserBakeryCode() && request.resource.data.bakeryCode == resource.data.bakeryCode) || 
                     isAdmin()
                    );
      allow delete: if isAuthenticated() && (resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
    }

    match /dailyClosings/{closingId} {
      allow read: if isAuthenticated() && (resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
      allow update: if isAuthenticated() && (
                     (resource.data.bakeryCode == getUserBakeryCode() && request.resource.data.bakeryCode == resource.data.bakeryCode) || 
                     isAdmin()
                    );
      allow delete: if isAuthenticated() && (resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
    }

    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
      allow update: if isAuthenticated() && (
                     (resource.data.bakeryCode == getUserBakeryCode() && request.resource.data.bakeryCode == resource.data.bakeryCode) || 
                     isAdmin()
                    );
      allow delete: if isAuthenticated() && (resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
    }

    match /inventoryMovements/{movementId} {
      allow read: if isAuthenticated() && (resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
      allow update: if isAuthenticated() && (
                     (resource.data.bakeryCode == getUserBakeryCode() && request.resource.data.bakeryCode == resource.data.bakeryCode) || 
                     isAdmin()
                    );
      allow delete: if isAuthenticated() && (resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
    }

    match /stockCounts/{countId} {
      allow read: if isAuthenticated() && (resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
      allow update: if isAuthenticated() && (
                     (resource.data.bakeryCode == getUserBakeryCode() && request.resource.data.bakeryCode == resource.data.bakeryCode) || 
                     isAdmin()
                    );
      allow delete: if isAuthenticated() && (resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
    }

    match /inventoryItems/{itemId} {
      allow read: if isAuthenticated() && (resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
      allow update: if isAuthenticated() && (
                     (resource.data.bakeryCode == getUserBakeryCode() && request.resource.data.bakeryCode == resource.data.bakeryCode) || 
                     isAdmin()
                    );
      allow delete: if isAuthenticated() && (resource.data.bakeryCode == getUserBakeryCode() || isAdmin());
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
